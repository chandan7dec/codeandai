# ============================================================
# Freebuff Registration - Environment Configuration
# ============================================================
# Copy this file to .env and update the values

# ── Application ──────────────────────────────────────────────
APP_NAME="Freebuff Registration"
DEBUG=false
BASE_URL=http://localhost:8000

# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=demo_class
DB_USER=root
DB_PASS=

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-this-in-production
ORGANIZER_API_KEY=organizer-secret-key

# ── Registration Form ────────────────────────────────────────
REGISTRATION_FORM_HEADING="Sign Up for Boot Camp"
# Index (0-based) of the active course in the DEMO_CLASSES catalog
# defined in config.php. The registration page shows this course's
# details and new registrations are saved against it.
# Example: ACTIVE_COURSE_INDEX=2 selects "Web Development Bootcamp Preview"
ACTIVE_COURSE_INDEX=0

# ── WhatsApp ─────────────────────────────────────────────────
WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/your-group-link
WHATSAPP_REDIRECT_BASE=https://wa.me

# Certification support group (certification.php). Falls back to the general
# group above when unset.
WHATSAPP_CERT_GROUP_URL=https://chat.whatsapp.com/FdvHuovo3Z8FbE05oRaj1K
WHATSAPP_CERT_GROUP_NAME=Certifications

# ── Email (SMTP) ─────────────────────────────────────────────
# Set ENABLE_EMAIL=true to enable sending confirmation emails
ENABLE_EMAIL=false

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-verified@email.com
SMTP_FROM_NAME="Freebuff Registration"

# ── Notes ────────────────────────────────────────────────────
# - For Gmail SMTP, use an App Password (not your regular password)
#   Generate at: https://myaccount.google.com/apppasswords
# - For SendGrid SMTP, use: smtp.sendgrid.net:587
# - For production, use a transactional email service like:
#   SendGrid, Mailgun, Amazon SES, or Postmark

# ── UPI Payments (direct UPI integration) ───────────
# Merchant UPI ID (VPA) that receives payments, e.g. yourname@okhdfcbank
UPI_MERCHANT_VPA=merchant@upi
# Display name shown in UPI apps when paying
UPI_MERCHANT_NAME="Freebuff Classes"
# Shared secret used to HMAC-SHA256 verify UPI payment callbacks
# MUST match the secret configured with your UPI provider/bank
UPI_CALLBACK_SECRET=change-this-callback-secret
# Minutes before an unpaid (initiated/pending) payment expires and the seat is released
UPI_PAYMENT_TIMEOUT_MINUTES=15
# Publicly reachable URL that receives UPI payment callbacks
# For local testing use a tunnel (e.g. ngrok): https://xxxx.ngrok.app/organizer/upi-callback.php
UPI_CALLBACK_URL=http://localhost:8000/organizer/upi-callback.php
